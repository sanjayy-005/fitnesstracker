# Copy this file to ".env" (same folder) and change the values.
# On Windows:  copy .env.example .env

# --- Django ---------------------------------------------------------------
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# --- MySQL ----------------------------------------------------------------
DB_ENGINE=mysql
DB_NAME=fittrack
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
# Cloud databases usually need SSL. On Render use:  /etc/ssl/certs/ca-certificates.crt
# Leave empty for a local MySQL server.
DB_SSL_CA=

# --- CORS (the frontend websites allowed to call this API) ------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# --- JWT ------------------------------------------------------------------
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# --- Printed on receipts ------------------------------------------------------
GYM_NAME=FitTrack Gym
GYM_ADDRESS=12 Fitness Street, Coimbatore, Tamil Nadu 641001
GYM_PHONE=+91 98765 43210
GYM_EMAIL=hello@fittrack.example

# --- Food calorie scan (Qwen2.5-VL via OpenAI-compatible API) ---------------
# Use mock for local demo without a key. Set openai_compatible + API key for real inference.
FOOD_AI_ENABLED=true
FOOD_AI_PROVIDER=mock
FOOD_AI_BASE_URL=https://router.huggingface.co/v1
FOOD_AI_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
FOOD_AI_API_KEY=
FOOD_AI_STRUCTURED_OUTPUT=json_schema
FOOD_AI_TIMEOUT_SECONDS=60
FOOD_AI_MAX_IMAGE_PX=1280
FOOD_AI_DAILY_SCANS_PER_USER=20

# --- Render only (set in the Render dashboard, not needed locally) -----------------
# SEED_DEMO_DATA=true   -> loads the demo data during deploy (only if the database is empty)
