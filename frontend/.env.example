# Copy this file to ".env" (same folder) before running "npm run dev".
# On Windows:  copy .env.example .env
#
# The URL of the Django API, including "/api" and WITHOUT a trailing slash.
# Local development:
VITE_API_URL=http://127.0.0.1:8000/api
# Production: set this as a Cloudflare Pages build variable (or in the local .env
# when building manually), using the public API URL:
# VITE_API_URL=https://api.yourdomain.com/api
